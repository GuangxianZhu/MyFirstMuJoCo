<mujoco model="hand_table">
  <!-- 桌面抓取场景：复用 hand.xml 的手（不改动它），加一张桌子和几个自由物体。
       桌面高度 0.10 m；桌面范围 x∈[-0.25, 0.45]，y∈[-0.35, 0.35]。
       物体初始 z = 桌面 + 半尺寸 + 0.0005（防止初始穿插）；sim.reset() 后回到这里写的位姿。
       物体 geom 必须 condim="4" 且带扭转摩擦（friction 第二项 0.02），否则方块会在指尖间绕捏取轴转掉。 -->
  <include file="hand.xml"/>

  <!-- 抓取需要"静摩擦"：MuJoCo 默认的软接触摩擦会缓慢蠕滑（实测捏住的方块抬起后约 6 mm/s 往下滑，1~3 s 内掉落）。
       noslip 求解器在每步后再把摩擦接触上的滑移消掉。只加在桌面场景里，hand.xml 不变。见 docs/NEXT_STAGE_B.md 附录 A。 -->
  <option noslip_iterations="10"/>

  <asset>
    <!-- 桌面用和地面不同的颜色，否则看不出桌子 -->
    <texture name="tabletop" type="2d" builtin="checker" rgb1="0.55 0.45 0.36" rgb2="0.60 0.50 0.40" width="300" height="300"/>
    <material name="table" texture="tabletop" texrepeat="6 6" reflectance="0.05"/>
  </asset>

  <worldbody>
    <geom name="table" type="box" size="0.35 0.35 0.05" pos="0.10 0 0.05"
          material="table" contype="1" conaffinity="1" friction="1.0 0.005 0.0001"/>
    <!-- 放置区标记（演示 3 的 B 点）：只是一块浅色薄片，不参与碰撞 -->
    <geom name="place_marker" type="cylinder" size="0.03 0.0005" pos="0.15 -0.12 0.1003"
          rgba="0.55 0.85 0.60 0.55" contype="0" conaffinity="0" group="1"/>

    <!-- 基线物体：3 cm 方块 -->
    <body name="cube" pos="0.15 0 0.1155">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.015 0.015 0.015" mass="0.03" rgba="0.9 0.35 0.3 1"
            contype="1" conaffinity="1" condim="4" friction="1.0 0.02 0.0001"/>
    </body>

    <!-- 易碎物（演示 3）：外形同 cube，黄色。"碎"是 Python 里按指力判定的（app/core/grasp.py），不是物理破碎 -->
    <body name="fragile" pos="0.15 0.12 0.1155">
      <freejoint name="fragile_free"/>
      <geom name="fragile_geom" type="box" size="0.015 0.015 0.015" mass="0.03" rgba="0.95 0.80 0.25 1"
            contype="1" conaffinity="1" condim="4" friction="1.0 0.02 0.0001"/>
    </body>

    <!-- 球（演示 4）：半径 2 cm。放在演示 3 的路径之外。
         决策门 G1：有了 noslip（静摩擦）后，原来的线性捏取姿态就能稳定捏起平桌面上的球；
         试过的降级方案（直立圆柱）在定位误差下并不比球好，柔顺参数下还够不到 1.5 N，所以保留球（见 docs/NEXT_STAGE_B.md 附录 A） -->
    <body name="ball" pos="0.03 -0.12 0.1205">
      <freejoint name="ball_free"/>
      <geom name="ball_geom" type="sphere" size="0.02" mass="0.03" rgba="0.30 0.60 0.90 1"
            contype="1" conaffinity="1" condim="4" friction="1.0 0.02 0.0001"/>
    </body>
  </worldbody>
</mujoco>
